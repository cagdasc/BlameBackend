{
  "name": "blamebackend",
  "version": "0.0.1",
  "description": "Real-time Kotlin Multiplatform Network Inspector & Terminal TUI for Ktor and OkHttp (Android, iOS, Desktop, Server)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/cagdasc/BlameBackend.git"
  },
  "bugs": {
    "url": "https://github.com/cagdasc/BlameBackend/issues"
  },
  "homepage": "https://github.com/cagdasc/BlameBackend#readme",
  "bin": {
    "blamebackend": "./bin/blamebackend.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "server.ts",
    "desktop-cli.ts",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "cli": "tsx desktop-cli.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild desktop-cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/desktop-cli.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
